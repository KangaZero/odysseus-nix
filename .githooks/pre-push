#!/usr/bin/env bash
# Runs `just test` before every push. Install with: just install-hooks
# Bypass for a single push: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v just >/dev/null 2>&1; then
  if command -v nix >/dev/null 2>&1; then
    echo "→ just not on PATH; running via nix develop" >&2
    exec nix develop --command just test
  fi
  echo "error: neither 'just' nor 'nix' on PATH — install one or run with --no-verify" >&2
  exit 1
fi

exec just test
